/*
========================================================================================
    Test Configuration
========================================================================================
    Minimal test profile for CI validation.
    Uses the bundled test data shipped with the STRiDE repository.

    Usage:
      nextflow run nextflow/main.nf -profile test,docker --outdir test_results
========================================================================================
*/

params {
    // Test sample sheet — single sample from bundled test data
    input = "${projectDir}/../tests/data/qc/test_samplesheet.csv"

    // Use bundled defaults (site list + model inside the container)
    site_list    = null
    model_joblib = null

    // Enable QC for full pipeline coverage
    generate_qc  = true

    // Reduced resources for CI
    max_cpus     = 2
    max_memory   = 4.GB
    max_time     = 1.h
}
