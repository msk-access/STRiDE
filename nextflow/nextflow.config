/*
========================================================================================
    STRiDE Nextflow Configuration
========================================================================================
    Default config options for all compute environments.
    Adopted from the py-gbcms Nextflow implementation.
----------------------------------------------------------------------------------------
*/

// ── Pipeline Parameters ───────────────────────────────────────────────────

params {
    // Input/Output
    input              = null       // Sample sheet CSV (required)
    outdir             = 'results'  // Output directory
    publish_dir_mode   = 'copy'     // How to publish output files

    // STRiDE-specific options
    model              = 'svm'      // Model architecture: 'svm', 'tabpfn', 'tabpfn_access_only', 'tabpfn_access_impact'
    site_list          = null       // MSI site list TSV (null = bundled 170-site)
    model_joblib       = null       // Trained model (null = bundled model)
    min_coverage       = 20         // Minimum read coverage per site
    max_repeat_bins    = 100        // Maximum repeat-count bins
    generate_qc        = true       // Generate interactive QC HTML report


    // Container version — pin for reproducibility
    stride_version     = 'latest'

    // Max resource limits (cluster-wide caps)
    max_cpus           = 16
    max_memory         = 128.GB
    max_time           = 240.h

    // Boilerplate
    tracedir           = "${params.outdir}/pipeline_info"
    help               = false
}

// ── Process Defaults ──────────────────────────────────────────────────────

process {
    cpus   = 1
    memory = 4.GB
    time   = 2.h
    shell  = ['/bin/bash', '-euo', 'pipefail']

    // Retry on OOM/SIGKILL (exit 137/143) — common on SLURM
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    // STRIDE_RUN: feature extraction is memory-intensive
    withName: STRIDE_RUN {
        cpus   = { check_max( 2 * task.attempt, 'cpus' ) }
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
        time   = { check_max( 2.h * task.attempt, 'time' ) }
    }

    // Standalone modules: lighter resources
    withName: STRIDE_FEATURES {
        cpus   = { check_max( 2 * task.attempt, 'cpus' ) }
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
        time   = { check_max( 2.h * task.attempt, 'time' ) }
    }
    withName: STRIDE_PREDICT {
        cpus   = 1
        memory = { check_max( 2.GB * task.attempt, 'memory' ) }
        time   = { check_max( 30.min * task.attempt, 'time' ) }
    }
    withName: STRIDE_QC {
        cpus   = 1
        memory = { check_max( 2.GB * task.attempt, 'memory' ) }
        time   = { check_max( 30.min * task.attempt, 'time' ) }
    }
}

// ── Execution Profiles ────────────────────────────────────────────────────

profiles {
    // Debug: print hostname before each task
    debug { process.beforeScript = 'echo $HOSTNAME' }

    // Docker (local development, CI)
    docker {
        docker.enabled       = true
        docker.userEmulation = true
        // --entrypoint="" overrides ENTRYPOINT ["stride"] so Nextflow can
        // execute its bash wrapper scripts inside the container
        docker.runOptions    = '--platform linux/amd64 --entrypoint=""'
        singularity.enabled  = false
        podman.enabled       = false
    }

    // Singularity (HPC)
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        podman.enabled         = false
    }

    // SLURM + Singularity (MSKCC cmobic cluster)
    slurm {
        process.executor       = 'slurm'
        process.queue          = 'cmobic_cpu'
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }

    // Local development (no container, requires stride installed locally)
    local {
        docker.enabled      = false
        singularity.enabled = false
        // macOS without container lacks ps for metrics
        trace.enabled       = false
        process {
            cpus   = 2
            memory = 8.GB
            time   = 24.h
        }
    }

    // Test profile — minimal inputs for CI
    test {
        includeConfig 'conf/test.config'
    }
}

// ── Execution Reports ─────────────────────────────────────────────────────
// Generates trace, report, timeline, and DAG for monitoring and debugging

trace {
    enabled   = true
    file      = "${params.tracedir}/execution_trace.txt"
    overwrite = true
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,'\
              + 'container,cpus,time,disk,memory,attempt,submit,start,'\
              + 'complete,duration,realtime,queue,%cpu,%mem,rss,vmem,'\
              + 'peak_rss,peak_vmem'
}

report {
    enabled   = true
    file      = "${params.tracedir}/execution_report.html"
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${params.tracedir}/execution_timeline.html"
    overwrite = true
}

dag {
    enabled   = true
    file      = "${params.tracedir}/pipeline_dag.svg"
    overwrite = true
}

// ── Pipeline Manifest ─────────────────────────────────────────────────────

manifest {
    name            = 'msk-access/stride'
    author          = 'MSK-ACCESS'
    description     = 'MSI prediction pipeline for MSK-ACCESS'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '0.1.0'
}

// ── Resource Capping Helper ───────────────────────────────────────────────
// Ensures requested resources don't exceed cluster maximums.
// Adopted from py-gbcms Nextflow implementation.

def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max memory '${params.max_memory}' is not valid! Using default: $obj"
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max time '${params.max_time}' is not valid! Using default: $obj"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            println "   ### ERROR ###   Max cpus '${params.max_cpus}' is not valid! Using default: $obj"
            return obj
        }
    }
}
